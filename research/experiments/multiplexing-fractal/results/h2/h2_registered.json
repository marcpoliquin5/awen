      "tensor-train": "core 1 on spatial modes (full mixing), core 2 on wavelength (diagonal weight + detector sum)"
    },
    "falsification": {
      "accuracy": "Killed if val_loss(candidate) - val_loss(baseline) has a 95% paired-t interval over seeds entirely > 0",
      "conversions": "Killed if conversions_per_useful_mac(candidate) >= conversions_per_useful_mac(baseline)",
      "latency": "Killed (v2 section 7) if it wins on parameters but forward latency is > 1.2x baseline"
