{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_research_ledger.v1.json",
  "title": "AWEN Research Ledger v1",
  "description": "One entry per research direction or paper. An entry is 'verified' only when its citation was checked against the publisher or a bibliographic registry; anything else is 'citation pending'.",
  "type": "object",
  "required": ["version", "entries"],
  "properties": {
    "version": {"const": "awen.research-ledger.v1"},
    "source_note": {"type": "string"},
    "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
  },
  "additionalProperties": false,
  "$defs": {
    "citation": {
      "type": "object",
      "required": ["title", "authors", "year"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "authors": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "year": {"type": "integer", "minimum": 1600, "maximum": 2100},
        "venue": {"type": "string"},
        "doi": {"type": "string", "pattern": "^10\\.[0-9]{4,9}/\\S+$"},
        "url": {"type": "string", "pattern": "^https://"}
      },
      "anyOf": [{"required": ["doi"]}, {"required": ["url"]}],
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "direction", "summary", "relevance", "awen_mapping", "maturity", "status"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
        "direction": {"type": "string", "minLength": 1},
        "summary": {"type": "string", "minLength": 1},
        "citation": {"$ref": "#/$defs/citation"},
        "key_results": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relevance": {"type": "string", "minLength": 1},
        "awen_mapping": {
          "type": "object",
          "required": ["state"],
          "properties": {
            "state": {"enum": ["implemented", "partial", "not-started"]},
            "modules": {"type": "array", "items": {"type": "string", "minLength": 1}},
            "next_step": {"type": "string"}
          },
          "additionalProperties": false
        },
        "maturity": {"enum": ["theory", "simulation", "lab-demonstration", "product"]},
        "hardware_needed": {"type": "string"},
        "open_questions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "tags": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["verified", "citation pending"]},
        "verification": {
          "type": "object",
          "required": ["method", "date"],
          "properties": {
            "method": {"type": "string", "minLength": 1},
            "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
          },
          "additionalProperties": false
        }
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "verified"}}}, "then": {"required": ["citation", "verification"]}}
      ],
      "additionalProperties": false
    }
  }
}
