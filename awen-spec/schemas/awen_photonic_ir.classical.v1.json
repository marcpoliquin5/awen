{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_photonic_ir.classical.v1.json",
  "title": "AWEN Classical Photonic IR v1",
  "type": "object",
  "required": [
    "ir_version", "source_ir_version", "backend_id", "tensors", "ops",
    "host_fallback_ops", "calibration"
  ],
  "properties": {
    "ir_version": { "const": "awen.photonic.classical.v1" },
    "source_ir_version": { "const": "awen.tensor.v1" },
    "backend_id": { "type": "string", "minLength": 1 },
    "tensors": { "type": "array", "items": { "$ref": "#/$defs/tensor" } },
    "ops": { "type": "array", "items": { "$ref": "#/$defs/tile_op" } },
    "host_fallback_ops": { "type": "array", "items": { "$ref": "#/$defs/fallback" } },
    "calibration": {
      "oneOf": [
        { "$ref": "awen_device_capability.v1.json#/properties/calibration_profile" },
        { "type": "null" }
      ]
    }
  },
  "$defs": {
    "tensor": {
      "type": "object",
      "required": ["id", "shape", "dtype", "layout"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "shape": { "type": "array", "items": { "type": "integer", "minimum": 1 } },
        "dtype": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] },
        "layout": { "enum": ["row_major", "column_major"] }
      },
      "additionalProperties": false
    },
    "tile": {
      "type": "object",
      "required": ["m_offset", "n_offset", "k_offset", "m", "n", "k"],
      "properties": {
        "m_offset": { "type": "integer", "minimum": 0 },
        "n_offset": { "type": "integer", "minimum": 0 },
        "k_offset": { "type": "integer", "minimum": 0 },
        "m": { "type": "integer", "minimum": 1 },
        "n": { "type": "integer", "minimum": 1 },
        "k": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "precision": {
      "type": "object",
      "required": [
        "source_dtype", "rhs_source_dtype", "compute_dtype", "output_dtype",
        "accumulator_dtype", "minimum_accumulator_bits", "optical_effective_bits",
        "dac_bits", "adc_bits", "bit_slices", "bit_slicing_mode",
        "digital_accumulation", "lhs_quantization", "rhs_quantization",
        "output_quantization", "analog_noise", "noise_seed", "calibration_compensation"
      ],
      "properties": {
        "source_dtype": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] },
        "rhs_source_dtype": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] },
        "compute_dtype": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] },
        "output_dtype": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] },
        "accumulator_dtype": { "enum": ["f32", "f64", "i32", "i64", "optical"] },
        "minimum_accumulator_bits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "optical_effective_bits": { "type": "integer", "minimum": 1 },
        "dac_bits": { "type": "integer", "minimum": 1 },
        "adc_bits": { "type": "integer", "minimum": 1 },
        "bit_slices": { "type": "integer", "minimum": 1 },
        "bit_slicing_mode": { "enum": ["none", "twos_complement", "signed_magnitude"] },
        "digital_accumulation": { "type": "boolean" },
        "lhs_quantization": { "$ref": "awen_precision.v1.json#/$defs/quantization" },
        "rhs_quantization": { "$ref": "awen_precision.v1.json#/$defs/quantization" },
        "output_quantization": { "$ref": "awen_precision.v1.json#/$defs/quantization" },
        "analog_noise": { "$ref": "awen_device_capability.v1.json#/$defs/analog_noise" },
        "noise_seed": { "type": "integer", "minimum": 0 },
        "calibration_compensation": {
          "type": ["object", "null"],
          "required": [
            "profile_id", "snapshot_fingerprint", "measured_gain", "measured_offset",
            "measured_phase_error_radians", "measured_insertion_loss_db", "rescale",
            "rebias", "residual_uncertainty"
          ],
          "properties": {
            "profile_id": { "type": "string", "minLength": 1 },
            "snapshot_fingerprint": { "type": "string", "minLength": 1 },
            "measured_gain": { "type": "number" },
            "measured_offset": { "type": "number" },
            "measured_phase_error_radians": { "type": "number" },
            "measured_insertion_loss_db": { "type": "number", "minimum": 0 },
            "rescale": { "type": "number" },
            "rebias": { "type": "number" },
            "residual_uncertainty": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tile_op": {
      "type": "object",
      "required": [
        "op_id", "type", "lhs", "rhs", "output", "transpose_lhs",
        "transpose_rhs", "tile", "precision", "wavelength_channels",
        "channel_ids", "cell_remaps", "calibration_impact", "accumulation_mode", "timing"
      ],
      "properties": {
        "op_id": { "type": "string", "minLength": 1 },
        "type": { "const": "photonic.gemm" },
        "lhs": { "type": "string", "minLength": 1 },
        "rhs": { "type": "string", "minLength": 1 },
        "output": { "type": "string", "minLength": 1 },
        "transpose_lhs": { "type": "boolean" },
        "transpose_rhs": { "type": "boolean" },
        "tile": { "$ref": "#/$defs/tile" },
        "precision": { "$ref": "#/$defs/precision" },
        "channel_ids": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "wavelength_channels": { "type": "array", "items": { "type": "number" } },
        "cell_remaps": { "type": "array", "items": { "$ref": "#/$defs/cell_remap" } },
        "calibration_impact": { "$ref": "#/$defs/calibration_impact" },
        "accumulation_mode": { "enum": ["optical", "digital", "hybrid"] },
        "calibration_handle": { "type": ["string", "null"] },
        "timing": {
          "type": "object",
          "required": ["start_ns", "duration_ns"],
          "properties": {
            "start_ns": { "type": "number", "minimum": 0 },
            "duration_ns": { "type": "number", "minimum": 0 }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "cell_remap": {
      "type": "object",
      "required": [
        "disabled_cell", "replacement_cell", "logical_row", "logical_column",
        "replacement_score"
      ],
      "properties": {
        "disabled_cell": { "type": "string", "minLength": 1 },
        "replacement_cell": { "type": "string", "minLength": 1 },
        "logical_row": { "type": "integer", "minimum": 0 },
        "logical_column": { "type": "integer", "minimum": 0 },
        "replacement_score": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "effective_transfer": {
      "type": "object",
      "required": [
        "gain", "offset", "phase_error_radians", "insertion_loss_db", "uncertainty"
      ],
      "properties": {
        "gain": { "type": "number" },
        "offset": { "type": "number" },
        "phase_error_radians": { "type": "number" },
        "insertion_loss_db": { "type": "number", "minimum": 0 },
        "uncertainty": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "calibration_impact": {
      "type": "object",
      "required": [
        "decision_version", "op_id", "disabled_components", "cell_remaps",
        "excluded_channels", "selected_channels", "selected_tile_shape",
        "capacity_loss_fraction", "estimated_error_fraction", "effective_transfer"
      ],
      "properties": {
        "decision_version": { "const": "awen.calibration-decision.v1" },
        "op_id": { "type": "string", "minLength": 1 },
        "disabled_components": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "cell_remaps": { "type": "array", "items": { "$ref": "#/$defs/cell_remap" } },
        "excluded_channels": {
          "type": "array", "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "selected_channels": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "selected_tile_shape": {
          "type": "array", "minItems": 3, "maxItems": 3,
          "items": { "type": "integer", "minimum": 1 }
        },
        "capacity_loss_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
        "estimated_error_fraction": { "type": "number", "minimum": 0 },
        "effective_transfer": { "$ref": "#/$defs/effective_transfer" }
      },
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "required": ["op_id", "op_type", "target", "reason"],
      "properties": {
        "op_id": { "type": "string" },
        "op_type": { "type": "string" },
        "target": { "enum": ["cpu", "gpu"] },
        "reason": { "type": "string" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
