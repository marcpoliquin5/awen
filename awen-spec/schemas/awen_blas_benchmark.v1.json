{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_blas_benchmark.v1.json",
  "title": "AWEN BLAS End-to-End Benchmark v1",
  "type": "object",
  "required": ["version", "request_id", "kind", "repetitions", "reference_wall_clock_ns", "simulator_wall_clock_ns", "maximum_absolute_error", "maximum_relative_error", "within_contract", "source", "measurement_boundary", "output_checksum"],
  "properties": {
    "version": {"const": "awen.blas-benchmark.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "kind": {"$ref": "awen_blas.v1.json#/$defs/kind"},
    "repetitions": {"type": "integer", "minimum": 1},
    "reference_wall_clock_ns": {"type": "integer", "minimum": 1},
    "simulator_wall_clock_ns": {"type": "integer", "minimum": 1},
    "maximum_absolute_error": {"type": "number", "minimum": 0},
    "maximum_relative_error": {"type": "number", "minimum": 0},
    "within_contract": {"type": "boolean"},
    "source": {"const": "measured"},
    "measurement_boundary": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "output_checksum": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"}
  },
  "additionalProperties": false
}
