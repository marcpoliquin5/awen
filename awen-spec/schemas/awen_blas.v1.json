{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_blas.v1.json",
  "title": "AWEN BLAS Kernel Request v1",
  "type": "object",
  "required": ["version", "id", "kind", "inputs"],
  "properties": {
    "version": {"const": "awen.blas.v1"},
    "id": {"type": "string", "minLength": 1},
    "kind": {"$ref": "#/$defs/kind"},
    "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/tensor"}},
    "attributes": {"$ref": "#/$defs/attributes"},
    "accuracy": {"$ref": "#/$defs/accuracy"},
    "calibration_inputs": {"type": "array", "items": {"$ref": "#/$defs/calibration"}}
  },
  "additionalProperties": false,
  "$defs": {
    "kind": {
      "enum": [
        "gemm", "batched_gemm", "complex_gemm", "linear", "transformer_qkv",
        "attention_scores", "attention_value", "mlp_projection", "convolution1d",
        "correlation1d", "dft", "fft", "fourier_filter", "low_rank_gemm",
        "random_projection", "toeplitz", "circulant", "block_circulant",
        "beamforming", "rf_fir", "reservoir_step", "propagation"
      ]
    },
    "complex": {
      "type": "object",
      "required": ["real", "imaginary"],
      "properties": {
        "real": {"type": "number"},
        "imaginary": {"type": "number"}
      },
      "additionalProperties": false
    },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "required": ["representation", "values"],
          "properties": {
            "representation": {"const": "real"},
            "values": {"type": "array", "items": {"type": "number"}}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["representation", "values"],
          "properties": {
            "representation": {"const": "complex"},
            "values": {"type": "array", "items": {"$ref": "#/$defs/complex"}}
          },
          "additionalProperties": false
        }
      ]
    },
    "tensor": {
      "type": "object",
      "required": ["id", "shape", "dtype", "layout", "data"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "dtype": {"enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"]},
        "layout": {"enum": ["row_major", "column_major"]},
        "data": {"$ref": "#/$defs/data"}
      },
      "additionalProperties": false
    },
    "attributes": {
      "type": "object",
      "properties": {
        "transpose_lhs": {"type": "boolean"},
        "transpose_rhs": {"type": "boolean"},
        "stride": {"type": "integer", "minimum": 1},
        "dilation": {"type": "integer", "minimum": 1},
        "padding": {"type": "integer", "minimum": 0},
        "block_size": {"type": "integer", "minimum": 1},
        "rank": {"type": "integer", "minimum": 0},
        "output_size": {"type": "integer", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0},
        "scale": {"type": "number"},
        "leakage": {"type": "number", "minimum": 0, "maximum": 1},
        "inverse": {"type": "boolean"},
        "phase_convention": {"enum": ["negative_exponent", "positive_exponent"]},
        "accumulation_mode": {"enum": ["optical", "digital", "hybrid"]}
      },
      "additionalProperties": false
    },
    "accuracy": {
      "type": "object",
      "properties": {
        "max_abs_error": {"type": "number", "minimum": 0},
        "max_rel_error": {"type": "number", "minimum": 0},
        "minimum_effective_bits": {"type": ["integer", "null"], "minimum": 1}
      },
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "required": ["id", "gain", "bias", "uncertainty_fraction"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "gain": {"type": "number", "not": {"const": 0}},
        "bias": {"type": "number"},
        "uncertainty_fraction": {"type": "number", "minimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    }
  }
}
