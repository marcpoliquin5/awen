{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_precision.v1.json",
  "title": "AWEN Precision Configuration v1",
  "type": "object",
  "required": ["version", "tensors", "operations"],
  "properties": {
    "version": { "const": "awen.precision.v1" },
    "tensors": { "type": "array", "items": { "$ref": "#/$defs/tensor_policy" } },
    "operations": { "type": "array", "items": { "$ref": "#/$defs/operation_policy" } }
  },
  "$defs": {
    "dtype": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] },
    "accumulator_dtype": { "enum": ["f32", "f64", "i32", "i64", "optical"] },
    "bit_slicing_mode": { "enum": ["none", "twos_complement", "signed_magnitude"] },
    "quantization": {
      "type": "object",
      "required": [
        "encoding", "bits", "signed", "granularity", "scales", "zero_points",
        "clipping_min", "clipping_max", "rounding", "overflow"
      ],
      "properties": {
        "encoding": {
          "enum": [
            "ieee_float", "bfloat", "affine_integer", "block_floating_point",
            "optical_effective_bits", "backend_native"
          ]
        },
        "bits": { "type": "integer", "minimum": 1, "maximum": 63 },
        "signed": { "type": "boolean" },
        "granularity": { "enum": ["per_tensor", "per_channel", "per_block"] },
        "axis": { "type": "integer", "minimum": 0 },
        "block_size": { "type": "integer", "minimum": 1 },
        "scales": {
          "type": "array", "minItems": 1,
          "items": { "type": "number", "exclusiveMinimum": 0 }
        },
        "zero_points": { "type": "array", "minItems": 1, "items": { "type": "integer" } },
        "clipping_min": { "type": "number" },
        "clipping_max": { "type": "number" },
        "rounding": { "enum": ["nearest_even", "toward_zero", "stochastic"] },
        "overflow": { "enum": ["saturate", "error"] },
        "backend_encoding": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "encoding": { "const": "ieee_float" } } },
          "then": {
            "properties": {
              "bits": { "enum": [16, 32] },
              "rounding": { "const": "nearest_even" }
            }
          }
        },
        {
          "if": { "properties": { "encoding": { "const": "bfloat" } } },
          "then": {
            "properties": {
              "bits": { "const": 16 },
              "rounding": { "const": "nearest_even" }
            }
          }
        },
        {
          "if": { "properties": { "encoding": { "const": "block_floating_point" } } },
          "then": { "properties": { "granularity": { "const": "per_block" } } }
        },
        {
          "if": { "properties": { "encoding": { "const": "backend_native" } } },
          "then": { "required": ["backend_encoding"] },
          "else": { "not": { "required": ["backend_encoding"] } }
        },
        {
          "if": { "properties": { "granularity": { "const": "per_tensor" } } },
          "then": {
            "not": { "anyOf": [{ "required": ["axis"] }, { "required": ["block_size"] }] }
          }
        },
        {
          "if": { "properties": { "granularity": { "const": "per_channel" } } },
          "then": {
            "required": ["axis"],
            "not": { "required": ["block_size"] }
          }
        },
        {
          "if": { "properties": { "granularity": { "const": "per_block" } } },
          "then": {
            "required": ["block_size"],
            "not": { "required": ["axis"] }
          }
        }
      ],
      "additionalProperties": false
    },
    "tensor_policy": {
      "type": "object",
      "required": ["tensor_id", "storage_dtype", "quantization"],
      "properties": {
        "tensor_id": { "type": "string", "minLength": 1 },
        "storage_dtype": { "$ref": "#/$defs/dtype" },
        "quantization": { "$ref": "#/$defs/quantization" }
      },
      "additionalProperties": false
    },
    "operation_policy": {
      "type": "object",
      "required": [
        "op_id", "compute_dtype", "output_dtype", "accumulator_dtype",
        "minimum_accumulator_bits", "allowed_bit_slicing_modes", "stochastic_seed"
      ],
      "properties": {
        "op_id": { "type": "string", "minLength": 1 },
        "compute_dtype": { "$ref": "#/$defs/dtype" },
        "output_dtype": { "$ref": "#/$defs/dtype" },
        "accumulator_dtype": { "$ref": "#/$defs/accumulator_dtype" },
        "minimum_accumulator_bits": { "type": "integer", "minimum": 1, "maximum": 64 },
        "allowed_bit_slicing_modes": {
          "type": "array", "minItems": 1, "uniqueItems": true,
          "items": { "$ref": "#/$defs/bit_slicing_mode" }
        },
        "stochastic_seed": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
