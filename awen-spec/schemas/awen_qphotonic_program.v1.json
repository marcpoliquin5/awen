{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_qphotonic_program.v1.json",
  "title": "AWEN Quantum-Photonic Program v1",
  "type": "object",
  "required": ["version", "program_id", "modes", "initial_state", "operations", "execution", "correctness", "capabilities"],
  "properties": {
    "version": {"const": "awen.qphotonic.program.v1"},
    "program_id": {"$ref": "#/$defs/id"},
    "modes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/mode"}},
    "initial_state": {"$ref": "#/$defs/initialState"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "execution": {"$ref": "#/$defs/execution"},
    "correctness": {"$ref": "#/$defs/correctness"},
    "capabilities": {"$ref": "#/$defs/capabilities"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "mode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["id", "state_space", "cutoff"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "state_space": {"const": "fock"}, "cutoff": {"type": "integer", "minimum": 2}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["id", "state_space"],
          "properties": {"id": {"$ref": "#/$defs/id"}, "state_space": {"const": "gaussian_cv"}},
          "additionalProperties": false
        }
      ]
    },
    "initialState": {
      "oneOf": [
        {
          "type": "object",
          "required": ["representation", "occupations"],
          "properties": {"representation": {"const": "fock"}, "occupations": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}}},
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["representation", "displacement", "covariance"],
          "properties": {
            "representation": {"const": "gaussian"},
            "displacement": {"type": "array", "minItems": 2, "items": {"type": "number"}},
            "covariance": {"type": "array", "minItems": 2, "items": {"type": "array", "minItems": 2, "items": {"type": "number"}}}
          },
          "additionalProperties": false
        }
      ]
    },
    "gate": {
      "oneOf": [
        {"type": "object", "required": ["gate", "theta_radians", "phi_radians"], "properties": {"gate": {"const": "beam_splitter"}, "theta_radians": {"type": "number"}, "phi_radians": {"type": "number"}}, "additionalProperties": false},
        {"type": "object", "required": ["gate", "radians"], "properties": {"gate": {"const": "phase_shift"}, "radians": {"type": "number"}}, "additionalProperties": false},
        {"type": "object", "required": ["gate", "magnitude", "angle_radians"], "properties": {"gate": {"const": "squeeze"}, "magnitude": {"type": "number", "minimum": 0}, "angle_radians": {"type": "number"}}, "additionalProperties": false},
        {"type": "object", "required": ["gate", "q", "p"], "properties": {"gate": {"const": "displace"}, "q": {"type": "number"}, "p": {"type": "number"}}, "additionalProperties": false},
        {"type": "object", "required": ["gate", "dimension"], "properties": {"gate": {"const": "controlled_x"}, "dimension": {"type": "integer", "minimum": 2}}, "additionalProperties": false},
        {"type": "object", "required": ["gate"], "properties": {"gate": {"const": "fourier"}}, "additionalProperties": false}
      ]
    },
    "operationCommon": {
      "type": "object",
      "required": ["op_id", "modes", "coherence_cost_ns"],
      "properties": {
        "op_id": {"$ref": "#/$defs/id"},
        "modes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "coherence_cost_ns": {"type": "integer", "minimum": 0}
      }
    },
    "operation": {
      "allOf": [
        {"$ref": "#/$defs/operationCommon"},
        {
          "oneOf": [
            {"required": ["operation", "gate_spec"], "properties": {"operation": {"const": "gate"}, "gate_spec": {"$ref": "#/$defs/gate"}}},
            {
              "required": ["operation", "measurement_id", "basis", "destructive"],
              "properties": {
                "operation": {"const": "measure"},
                "measurement_id": {"$ref": "#/$defs/id"},
                "basis": {"enum": ["photon_counting", "homodyne_q", "homodyne_p", "heterodyne"]},
                "destructive": {"type": "boolean"}
              }
            },
            {
              "required": ["operation", "source_measurement_id", "target_operation_id", "parameter", "scale", "offset", "maximum_latency_ns"],
              "properties": {
                "operation": {"const": "feed_forward"},
                "source_measurement_id": {"$ref": "#/$defs/id"},
                "target_operation_id": {"$ref": "#/$defs/id"},
                "parameter": {"enum": ["phase_radians", "displacement_q", "displacement_p", "squeezing_magnitude"]},
                "scale": {"type": "number"},
                "offset": {"type": "number"},
                "maximum_latency_ns": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "execution": {
      "type": "object",
      "required": ["shots", "seed", "deterministic_replay", "coherence_budget_ns"],
      "properties": {
        "shots": {"type": "integer", "minimum": 1},
        "seed": {"type": "integer", "minimum": 0},
        "deterministic_replay": {"const": true},
        "coherence_budget_ns": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "probabilities": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "number", "minimum": 0, "maximum": 1}},
    "means": {"type": "object", "additionalProperties": {"type": "number"}},
    "correctness": {
      "type": "object",
      "required": ["expected_distribution", "expected_means", "maximum_total_variation_distance", "maximum_mean_error", "minimum_fidelity", "confidence_level"],
      "properties": {
        "expected_distribution": {"$ref": "#/$defs/probabilities"},
        "expected_means": {"$ref": "#/$defs/means"},
        "maximum_total_variation_distance": {"type": "number", "minimum": 0, "maximum": 1},
        "maximum_mean_error": {"type": "number", "minimum": 0},
        "minimum_fidelity": {"type": "number", "minimum": 0, "maximum": 1},
        "confidence_level": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      },
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["state_spaces", "gates", "measurements", "feed_forward", "minimum_modes", "maximum_fock_cutoff", "minimum_coherence_ns"],
      "properties": {
        "state_spaces": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["fock", "gaussian_cv"]}},
        "gates": {"type": "array", "uniqueItems": true, "items": {"enum": ["beam_splitter", "phase_shift", "squeeze", "displace", "controlled_x", "fourier"]}},
        "measurements": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["photon_counting", "homodyne_q", "homodyne_p", "heterodyne"]}},
        "feed_forward": {"type": "boolean"},
        "minimum_modes": {"type": "integer", "minimum": 1},
        "maximum_fock_cutoff": {"type": ["integer", "null"], "minimum": 2},
        "minimum_coherence_ns": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    }
  }
}
