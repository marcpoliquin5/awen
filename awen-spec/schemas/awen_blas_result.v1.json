{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_blas_result.v1.json",
  "title": "AWEN BLAS Kernel Result v1",
  "type": "object",
  "required": ["version", "request_id", "kind", "outputs", "descriptor", "execution_target", "simulated", "execution_fingerprint"],
  "properties": {
    "version": {"const": "awen.blas.v1"},
    "request_id": {"type": "string", "minLength": 1},
    "kind": {"$ref": "awen_blas.v1.json#/$defs/kind"},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "awen_blas.v1.json#/$defs/tensor"}},
    "descriptor": {"$ref": "#/$defs/descriptor"},
    "execution_target": {"enum": ["cpu", "gpu", "photonic"]},
    "simulated": {"type": "boolean"},
    "execution_fingerprint": {"type": "string", "pattern": "^fnv1a64:[0-9a-f]{16}$"}
  },
  "additionalProperties": false,
  "$defs": {
    "structure": {
      "enum": ["dense", "low_rank", "random_projection", "toeplitz", "circulant", "block_circulant", "convolutional", "fourier", "beamforming", "reservoir", "propagation"]
    },
    "descriptor": {
      "type": "object",
      "required": ["id", "kind", "input_shapes", "output_shapes", "dtypes", "layouts", "structure", "phase_convention", "accumulation_mode", "minimum_effective_bits", "maximum_absolute_error", "maximum_relative_error", "calibration_inputs", "operations"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"$ref": "awen_blas.v1.json#/$defs/kind"},
        "input_shapes": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}},
        "output_shapes": {"type": "array", "minItems": 1, "items": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}}},
        "dtypes": {"type": "array", "minItems": 1, "items": {"enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"]}},
        "layouts": {"type": "array", "minItems": 1, "items": {"enum": ["row_major", "column_major"]}},
        "structure": {"$ref": "#/$defs/structure"},
        "phase_convention": {"oneOf": [{"enum": ["negative_exponent", "positive_exponent"]}, {"type": "null"}]},
        "accumulation_mode": {"enum": ["optical", "digital", "hybrid"]},
        "minimum_effective_bits": {"type": ["integer", "null"], "minimum": 1},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_relative_error": {"type": "number", "minimum": 0},
        "calibration_inputs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "operations": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    }
  }
}
