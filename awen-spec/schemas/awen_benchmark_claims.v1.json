{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_benchmark_claims.v1.json",
  "title": "AWEN Verified Public Benchmark Claims v1",
  "type": "object",
  "required": ["version", "suite_id", "artifact_url", "artifact_fingerprint", "baseline_backend_id", "candidate_backend_id", "generated_at", "claims", "verification", "claims_fingerprint"],
  "properties": {
    "version": {"const": "awen.benchmark-claims.v1"},
    "suite_id": {"type": "string", "minLength": 1},
    "artifact_url": {"type": "string", "pattern": "^https://"},
    "artifact_fingerprint": {"$ref": "#/$defs/fingerprint"},
    "baseline_backend_id": {"type": "string", "minLength": 1},
    "candidate_backend_id": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "claims": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
    "verification": {"const": "verified"},
    "claims_fingerprint": {"$ref": "#/$defs/fingerprint"}
  },
  "additionalProperties": false,
  "$defs": {
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "source": {"enum": ["measured", "simulated", "vendor_specified", "estimated"]},
    "claim": {
      "type": "object",
      "required": ["metric", "value", "unit", "statement", "baseline_source", "candidate_source"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "baseline_source": {"$ref": "#/$defs/source"},
        "candidate_source": {"$ref": "#/$defs/source"}
      },
      "additionalProperties": false
    }
  }
}
