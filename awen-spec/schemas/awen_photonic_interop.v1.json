{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_photonic_interop.v1.json",
  "title": "AWEN Classical/Quantum Photonic Interoperability v1",
  "type": "object",
  "required": ["version", "program_id", "operations"],
  "properties": {
    "version": {"const": "awen.photonic-interop.v1"},
    "program_id": {"$ref": "#/$defs/id"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": ["operation", "op_id", "quantum_program_id", "measurement_id", "classical_output"],
          "properties": {
            "operation": {"const": "measurement_readout"},
            "op_id": {"$ref": "#/$defs/id"},
            "quantum_program_id": {"$ref": "#/$defs/id"},
            "measurement_id": {"$ref": "#/$defs/id"},
            "classical_output": {"$ref": "#/$defs/id"}
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": ["operation", "op_id", "classical_input", "quantum_program_id", "target_operation_id", "parameter", "scale", "offset", "maximum_latency_ns"],
          "properties": {
            "operation": {"const": "classical_control"},
            "op_id": {"$ref": "#/$defs/id"},
            "classical_input": {"$ref": "#/$defs/id"},
            "quantum_program_id": {"$ref": "#/$defs/id"},
            "target_operation_id": {"$ref": "#/$defs/id"},
            "parameter": {"enum": ["phase_radians", "displacement_q", "displacement_p", "squeezing_magnitude"]},
            "scale": {"type": "number"},
            "offset": {"type": "number"},
            "maximum_latency_ns": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        }
      ]
    }
  }
}
