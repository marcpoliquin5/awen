{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_photonic_program.v1.json",
  "title": "AWEN Classical Photonic Program v1",
  "type": "object",
  "required": ["version", "program_id", "signals", "operations", "outputs", "capabilities"],
  "properties": {
    "version": {"const": "awen.photonic.program.v1"},
    "program_id": {"$ref": "#/$defs/id"},
    "signals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/signal"}},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
    "capabilities": {"$ref": "#/$defs/capabilities"}
  },
  "additionalProperties": false,
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"},
    "fingerprint": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "signal": {
      "type": "object",
      "required": ["id", "shape", "encoding"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "shape": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 1}},
        "encoding": {"enum": ["real_amplitude", "complex_field", "intensity"]}
      },
      "additionalProperties": false
    },
    "precision": {
      "type": "object",
      "required": ["input_bits", "optical_effective_bits", "dac_bits", "adc_bits", "accumulator_bits", "maximum_absolute_error", "maximum_relative_error"],
      "properties": {
        "input_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "optical_effective_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "dac_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "adc_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "accumulator_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "maximum_absolute_error": {"type": "number", "minimum": 0},
        "maximum_relative_error": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "noise": {
      "type": "object",
      "required": ["kind", "rms_fraction", "seed"],
      "properties": {
        "kind": {"enum": ["shot", "thermal", "phase", "detector", "composite"]},
        "rms_fraction": {"type": "number", "minimum": 0},
        "seed": {"type": "integer", "minimum": 0}
      },
      "additionalProperties": false
    },
    "transfer": {
      "type": "object",
      "required": ["model", "coefficients", "calibration_snapshot_id", "calibration_fingerprint", "maximum_residual_error"],
      "properties": {
        "model": {"enum": ["affine", "matrix", "detector_response"]},
        "coefficients": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "calibration_snapshot_id": {"$ref": "#/$defs/id"},
        "calibration_fingerprint": {"$ref": "#/$defs/fingerprint"},
        "maximum_residual_error": {"type": "number", "minimum": 0}
      },
      "additionalProperties": false
    },
    "timing": {
      "type": "object",
      "required": ["start_ns", "duration_ns", "dependencies"],
      "properties": {
        "start_ns": {"type": "integer", "minimum": 0},
        "duration_ns": {"type": "integer", "minimum": 1},
        "dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      },
      "additionalProperties": false
    },
    "operationCommon": {
      "type": "object",
      "required": ["op_id", "inputs", "outputs", "precision", "noise", "transfer", "timing"],
      "properties": {
        "op_id": {"$ref": "#/$defs/id"},
        "inputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/id"}},
        "precision": {"$ref": "#/$defs/precision"},
        "noise": {"$ref": "#/$defs/noise"},
        "transfer": {"$ref": "#/$defs/transfer"},
        "timing": {"$ref": "#/$defs/timing"}
      }
    },
    "operation": {
      "allOf": [
        {"$ref": "#/$defs/operationCommon"},
        {
          "oneOf": [
            {
              "required": ["operation", "m", "n", "k", "transpose_lhs", "transpose_rhs"],
              "properties": {
                "operation": {"const": "gemm"},
                "m": {"type": "integer", "minimum": 1},
                "n": {"type": "integer", "minimum": 1},
                "k": {"type": "integer", "minimum": 1},
                "transpose_lhs": {"type": "boolean"},
                "transpose_rhs": {"type": "boolean"}
              }
            },
            {
              "required": ["operation", "transform", "phase_radians", "power_ratio"],
              "properties": {
                "operation": {"const": "analog_transform"},
                "transform": {"enum": ["splitter", "phase_shift", "interferometer"]},
                "phase_radians": {"type": ["number", "null"]},
                "power_ratio": {"type": ["number", "null"], "minimum": 0, "maximum": 1}
              }
            },
            {
              "required": ["operation", "modulation", "carrier_wavelength_nm"],
              "properties": {
                "operation": {"const": "modulate"},
                "modulation": {"enum": ["amplitude", "phase", "in_phase_quadrature"]},
                "carrier_wavelength_nm": {"type": "number", "exclusiveMinimum": 0}
              }
            },
            {
              "required": ["operation", "detection", "integration_time_ns"],
              "properties": {
                "operation": {"const": "detect"},
                "detection": {"enum": ["direct", "homodyne", "heterodyne"]},
                "integration_time_ns": {"type": "integer", "minimum": 1}
              }
            }
          ]
        }
      ],
      "unevaluatedProperties": false
    },
    "capabilities": {
      "type": "object",
      "required": ["operations", "minimum_optical_bits", "minimum_dac_bits", "minimum_adc_bits", "calibrated_transfer_required"],
      "properties": {
        "operations": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["gemm", "analog_transform", "modulate", "detect"]}},
        "minimum_optical_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "minimum_dac_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "minimum_adc_bits": {"type": "integer", "minimum": 1, "maximum": 255},
        "calibrated_transfer_required": {"const": true}
      },
      "additionalProperties": false
    }
  }
}
