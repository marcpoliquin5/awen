{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_device_capability.v1.json",
  "title": "AWEN Device Capability v1",
  "type": "object",
  "required": [
    "capability_version",
    "runtime_abi_version",
    "plugin_abi_version",
    "backend_id",
    "matrix_core",
    "supported_operations",
    "supported_dtypes",
    "supported_wavelengths_nm",
    "modulation_rate_gbaud",
    "coherence_mode",
    "adc_bits",
    "dac_bits",
    "effective_bits",
    "bit_slicing_modes",
    "saturation_mode",
    "input_dynamic_range",
    "analog_noise",
    "sample_rate_gsps",
    "reconfiguration_latency_ns",
    "detector_bandwidth_ghz",
    "insertion_loss_budget_db",
    "supports_complex",
    "simultaneous_channels",
    "accumulation_modes",
    "calibration_requirements",
    "physical_design",
    "host_bandwidth_gbps",
    "link_bandwidth_gbps",
    "boundary_latency_ns",
    "laser_power_mw",
    "total_power_budget_mw",
    "dac_energy_pj_per_sample",
    "adc_energy_pj_per_sample"
  ],
  "properties": {
    "capability_version": { "const": "awen.device-capability.v1" },
    "runtime_abi_version": { "const": "awen.runtime-backend.v1" },
    "plugin_abi_version": { "const": "awen.backend-plugin.v1" },
    "backend_id": { "type": "string", "minLength": 1 },
    "matrix_core": {
      "type": "object",
      "required": ["m", "n", "k"],
      "properties": {
        "m": { "type": "integer", "minimum": 1 },
        "n": { "type": "integer", "minimum": 1 },
        "k": { "type": "integer", "minimum": 1 }
      },
      "additionalProperties": false
    },
    "supported_operations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "operation",
          "supports_transpose_lhs",
          "supports_transpose_rhs",
          "supports_partial_m",
          "supports_partial_n",
          "supports_partial_k"
        ],
        "properties": {
          "operation": { "const": "gemm" },
          "supports_transpose_lhs": { "type": "boolean" },
          "supports_transpose_rhs": { "type": "boolean" },
          "supports_partial_m": { "type": "boolean" },
          "supports_partial_n": { "type": "boolean" },
          "supports_partial_k": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "supported_dtypes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["f32", "f16", "bf16", "int8", "int4", "complex_f32"] }
    },
    "supported_wavelengths_nm": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "number", "exclusiveMinimum": 0 }
    },
    "modulation_rate_gbaud": { "type": "number", "exclusiveMinimum": 0 },
    "coherence_mode": { "enum": ["coherent", "incoherent", "both"] },
    "adc_bits": { "type": "integer", "minimum": 1, "maximum": 32 },
    "dac_bits": { "type": "integer", "minimum": 1, "maximum": 32 },
    "effective_bits": { "type": "integer", "minimum": 1, "maximum": 32 },
    "bit_slicing_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["none", "twos_complement", "signed_magnitude"] }
    },
    "saturation_mode": { "enum": ["clamp", "error"] },
    "input_dynamic_range": {
      "type": "object",
      "required": ["minimum", "maximum"],
      "properties": {
        "minimum": { "type": "number" },
        "maximum": { "type": "number" }
      },
      "additionalProperties": false
    },
    "analog_noise": { "$ref": "#/$defs/analog_noise" },
    "sample_rate_gsps": { "type": "number", "exclusiveMinimum": 0 },
    "reconfiguration_latency_ns": { "type": "number", "minimum": 0 },
    "detector_bandwidth_ghz": { "type": "number", "exclusiveMinimum": 0 },
    "insertion_loss_budget_db": { "type": "number", "minimum": 0 },
    "supports_complex": { "type": "boolean" },
    "simultaneous_channels": { "type": "integer", "minimum": 1 },
    "accumulation_modes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["optical", "digital", "hybrid"] }
    },
    "calibration_requirements": {
      "type": "object",
      "required": ["required", "maximum_age_seconds", "temperature_tolerance_c", "drift_tolerance"],
      "properties": {
        "required": { "type": "boolean" },
        "maximum_age_seconds": { "type": "integer", "minimum": 0 },
        "temperature_tolerance_c": { "type": "number", "minimum": 0 },
        "drift_tolerance": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "calibration_profile": {
      "$ref": "awen_calibration_snapshot.v1.json"
    },
    "physical_design": {
      "$ref": "awen_physical_design.v1.json#/$defs/binding"
    },
    "host_bandwidth_gbps": { "type": "number", "exclusiveMinimum": 0 },
    "link_bandwidth_gbps": { "type": "number", "exclusiveMinimum": 0 },
    "boundary_latency_ns": { "type": "number", "minimum": 0 },
    "laser_power_mw": { "type": "number", "minimum": 0 },
    "total_power_budget_mw": { "type": "number", "exclusiveMinimum": 0 },
    "dac_energy_pj_per_sample": { "type": "number", "minimum": 0 },
    "adc_energy_pj_per_sample": { "type": "number", "minimum": 0 }
  },
  "$defs": {
    "analog_noise": {
      "type": "object",
      "required": [
        "shot_noise_fraction", "thermal_noise_fraction", "phase_noise_radians",
        "detector_noise_fraction"
      ],
      "properties": {
        "shot_noise_fraction": { "type": "number", "minimum": 0 },
        "thermal_noise_fraction": { "type": "number", "minimum": 0 },
        "phase_noise_radians": { "type": "number", "minimum": 0 },
        "detector_noise_fraction": { "type": "number", "minimum": 0 }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
