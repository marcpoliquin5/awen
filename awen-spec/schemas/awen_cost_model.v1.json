{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://awen.dev/schemas/awen_cost_model.v1.json",
  "title": "AWEN Full-System Cost Model v1",
  "type": "object",
  "required": [
    "model_version",
    "scheduling_latency_ns",
    "memory_bandwidth_gbps",
    "memory_energy_pj_per_byte",
    "host_transfer_energy_pj_per_byte",
    "modulator_energy_pj_per_sample",
    "detector_energy_pj_per_sample",
    "digital_accumulation_energy_pj_per_mac",
    "digital_accumulation_throughput_gops",
    "optical_propagation_ns",
    "calibration_amortization_ns",
    "calibration_amortization_energy_uj",
    "support_power_mw",
    "signal_to_noise_ratio_db",
    "insertion_loss_db",
    "drift_fraction",
    "disabled_component_fraction",
    "latency_calibration_factor",
    "energy_calibration_factor",
    "error_calibration_offset",
    "provenance"
  ],
  "properties": {
    "model_version": { "const": "awen.cost-model.v1" },
    "scheduling_latency_ns": { "type": "number", "minimum": 0 },
    "memory_bandwidth_gbps": { "type": "number", "exclusiveMinimum": 0 },
    "memory_energy_pj_per_byte": { "type": "number", "minimum": 0 },
    "host_transfer_energy_pj_per_byte": { "type": "number", "minimum": 0 },
    "modulator_energy_pj_per_sample": { "type": "number", "minimum": 0 },
    "detector_energy_pj_per_sample": { "type": "number", "minimum": 0 },
    "digital_accumulation_energy_pj_per_mac": { "type": "number", "minimum": 0 },
    "digital_accumulation_throughput_gops": { "type": "number", "exclusiveMinimum": 0 },
    "optical_propagation_ns": { "type": "number", "minimum": 0 },
    "calibration_amortization_ns": { "type": "number", "minimum": 0 },
    "calibration_amortization_energy_uj": { "type": "number", "minimum": 0 },
    "support_power_mw": { "type": "number", "minimum": 0 },
    "signal_to_noise_ratio_db": { "type": "number", "exclusiveMinimum": 0 },
    "insertion_loss_db": { "type": "number", "minimum": 0 },
    "drift_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "disabled_component_fraction": { "type": "number", "minimum": 0, "maximum": 1 },
    "latency_calibration_factor": { "type": "number", "exclusiveMinimum": 0 },
    "energy_calibration_factor": { "type": "number", "exclusiveMinimum": 0 },
    "error_calibration_offset": { "type": "number", "minimum": 0 },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["parameter", "source", "reference", "uncertainty_fraction"],
        "properties": {
          "parameter": { "type": "string", "minLength": 1 },
          "source": {
            "enum": ["measured", "vendor_specified", "simulated", "assumed"]
          },
          "reference": { "type": "string", "minLength": 1 },
          "uncertainty_fraction": { "type": "number", "minimum": 0, "maximum": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
